{"name": "bytes_option_short", "description": "Test -c option to read bytes", "cmd_prep": "printf 'abcdefghijklmnopqrstuvwxyz' > test_bytes.txt", "cmd_target": "BINARY -c 10 test_bytes.txt", "cmd_post": "rm -f test_bytes.txt", "idx": 1, "norm_rules": []}
{"name": "bytes_option_long", "description": "Test --bytes option", "cmd_prep": "printf 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' > test_bytes2.txt", "cmd_target": "BINARY --bytes=15 test_bytes2.txt", "cmd_post": "rm -f test_bytes2.txt", "idx": 2, "norm_rules": []}
{"name": "bytes_option_5", "description": "Test reading 5 bytes", "cmd_prep": "printf '1234567890' > test_bytes3.txt", "cmd_target": "BINARY -c 5 test_bytes3.txt", "cmd_post": "rm -f test_bytes3.txt", "idx": 3, "norm_rules": []}
{"name": "bytes_stdin", "description": "Test bytes from stdin", "cmd_prep": "printf 'hello world this is a test' > test_stdin.txt", "cmd_target": "BINARY -c 11 < test_stdin.txt", "cmd_post": "rm -f test_stdin.txt", "idx": 4, "norm_rules": []}
{"name": "bytes_multiple_files", "description": "Test bytes mode with multiple files", "cmd_prep": "printf 'file1data' > f1.txt && printf 'file2data' > f2.txt", "cmd_target": "BINARY -c 5 f1.txt f2.txt", "cmd_post": "rm -f f1.txt f2.txt", "idx": 5, "norm_rules": []}
{"name": "bytes_zero_count", "description": "Test zero bytes", "cmd_prep": "printf 'some data here' > test.txt", "cmd_target": "BINARY -c 0 test.txt", "cmd_post": "rm -f test.txt", "idx": 6, "norm_rules": []}
{"name": "bytes_large_count", "description": "Test bytes larger than file", "cmd_prep": "printf 'small' > small.txt", "cmd_target": "BINARY -c 1000 small.txt", "cmd_post": "rm -f small.txt", "idx": 7, "norm_rules": []}

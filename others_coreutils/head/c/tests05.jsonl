{"name": "bytes_stdin_dash", "description": "Test -c with explicit stdin marker", "cmd_prep": "printf 'testing stdin' > stdin_test.txt", "cmd_target": "BINARY -c 7 - < stdin_test.txt", "cmd_post": "rm -f stdin_test.txt", "idx": 21, "norm_rules": []}
{"name": "zero_lines_explicit", "description": "Test explicitly requesting 0 lines", "cmd_prep": "printf 'line1\\nline2\\nline3\\n' > zero.txt", "cmd_target": "BINARY -n 0 zero.txt", "cmd_post": "rm -f zero.txt", "idx": 22, "norm_rules": []}

{"name": "quiet_option_long", "description": "Test --quiet option", "cmd_prep": "printf 'a\\nb\\n' > qa.txt && printf 'c\\nd\\n' > qb.txt", "cmd_target": "BINARY --quiet qa.txt qb.txt", "cmd_post": "rm -f qa.txt qb.txt", "idx": 9, "norm_rules": []}
{"name": "silent_option_long", "description": "Test --silent option", "cmd_prep": "printf 'test1\\n' > s1.txt && printf 'test2\\n' > s2.txt", "cmd_target": "BINARY --silent s1.txt s2.txt", "cmd_post": "rm -f s1.txt s2.txt", "idx": 10, "norm_rules": []}
{"name": "verbose_option_short", "description": "Test -v option to always show headers", "cmd_prep": "printf 'single file\\n' > v1.txt", "cmd_target": "BINARY -v v1.txt", "cmd_post": "rm -f v1.txt", "idx": 11, "norm_rules": []}
{"name": "verbose_option_long", "description": "Test --verbose option", "cmd_prep": "printf 'another single file\\n' > v2.txt", "cmd_target": "BINARY --verbose v2.txt", "cmd_post": "rm -f v2.txt", "idx": 12, "norm_rules": []}
{"name": "zero_terminated_short", "description": "Test -z option for NUL delimiter", "cmd_prep": "printf 'line1\\0line2\\0line3\\0' > z1.txt", "cmd_target": "BINARY -z -n 2 z1.txt", "cmd_post": "rm -f z1.txt", "idx": 13, "norm_rules": []}
{"name": "zero_terminated_long", "description": "Test --zero-terminated option", "cmd_prep": "printf 'a\\0b\\0c\\0d\\0' > z2.txt", "cmd_target": "BINARY --zero-terminated -n 3 z2.txt", "cmd_post": "rm -f z2.txt", "idx": 14, "norm_rules": []}
{"name": "version_option", "description": "Test --version option", "cmd_prep": "", "cmd_target": "BINARY --version", "cmd_post": "", "idx": 15, "norm_rules": [{"pattern": "head \\(GNU coreutils\\) [0-9.]+", "replacement": "head (GNU coreutils) VERSION"}, {"pattern": "Copyright \\(C\\) [0-9]+ Free Software Foundation, Inc\\.", "replacement": "Copyright (C) YEAR Free Software Foundation, Inc."}, {"pattern": "Written by.*", "replacement": "Written by AUTHORS"}]}

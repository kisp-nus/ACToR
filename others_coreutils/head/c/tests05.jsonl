{"name": "long_bytes_option", "description": "Test --bytes with large value", "cmd_prep": "dd if=/dev/zero bs=1024 count=5 2>/dev/null > big.dat", "cmd_target": "BINARY --bytes=2048 big.dat", "cmd_post": "rm -f big.dat", "idx": 26, "norm_rules": []}

{"name": "lines_with_multiplier", "description": "Test lines count with multiplier suffix", "cmd_prep": "for i in $(seq 1 100); do echo \"line $i\"; done > many_lines.txt", "cmd_target": "BINARY -n 50 many_lines.txt", "cmd_post": "rm -f many_lines.txt", "idx": 18, "norm_rules": []}

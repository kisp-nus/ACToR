{"name": "quiet_single_file", "description": "Test quiet with single file", "cmd_prep": "printf 'data\\nmore\\n' > quiet_single.txt", "cmd_target": "BINARY -q quiet_single.txt", "cmd_post": "rm -f quiet_single.txt", "idx": 28, "norm_rules": []}

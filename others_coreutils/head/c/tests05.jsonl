{"name": "multiple_n_options", "description": "Test multiple -n options (last wins)", "cmd_prep": "printf 'a\\nb\\nc\\nd\\ne\\n' > multi.txt", "cmd_target": "BINARY -n 2 -n 3 multi.txt", "cmd_post": "rm -f multi.txt", "idx": 24, "norm_rules": []}

{"name":"basic_cat","description":"Basic cat functionality with single file","cmd_prep":"echo 'Hello World' > input.txt","cmd_target":"BINARY input.txt","cmd_post":"rm -f input.txt","idx":1,"norm_rules":[]}
{"name":"empty_file","description":"Cat empty file","cmd_prep":"touch empty.txt","cmd_target":"BINARY empty.txt","cmd_post":"rm -f empty.txt","idx":2,"norm_rules":[]}
{"name":"multiple_files","description":"Concatenate multiple files","cmd_prep":"echo 'First' > file1.txt && echo 'Second' > file2.txt","cmd_target":"BINARY file1.txt file2.txt","cmd_post":"rm -f file1.txt file2.txt","idx":3,"norm_rules":[]}
{"name":"nonexistent_file","description":"Cat nonexistent file should error","cmd_prep":"true","cmd_target":"BINARY nonexistent.txt","cmd_post":"true","idx":4,"norm_rules":[{"pattern":"\\./{progname}:","replacement":""},{"pattern":"{progname}:","replacement":""}]}
{"name":"stdin_only","description":"Cat from stdin only","cmd_prep":"echo 'From stdin' > input.txt","cmd_target":"BINARY < input.txt","cmd_post":"rm -f input.txt","idx":5,"norm_rules":[]}
{"name":"mixed_files_and_stdin","description":"Mix files and stdin","cmd_prep":"echo 'File content' > file.txt && echo 'Stdin content' > input.txt","cmd_target":"BINARY file.txt - file.txt < input.txt","cmd_post":"rm -f file.txt input.txt","idx":6,"norm_rules":[]}
{"name":"number_lines_flag","description":"Number all lines with -n","cmd_prep":"echo -e 'Line 1\\nLine 2\\nLine 3' > input.txt","cmd_target":"BINARY -n input.txt","cmd_post":"rm -f input.txt","idx":7,"norm_rules":[]}
{"name":"number_nonblank_flag","description":"Number non-blank lines with -b","cmd_prep":"echo -e 'Line 1\\n\\nLine 3' > input.txt","cmd_target":"BINARY -b input.txt","cmd_post":"rm -f input.txt","idx":8,"norm_rules":[]}
{"name":"show_ends_flag","description":"Show line ends with -e","cmd_prep":"echo -e 'Line 1\\nLine 2' > input.txt","cmd_target":"BINARY -e input.txt","cmd_post":"rm -f input.txt","idx":9,"norm_rules":[]}
{"name":"show_tabs_flag","description":"Show tabs with -t","cmd_prep":"echo -e 'Tab:\\there' > input.txt","cmd_target":"BINARY -t input.txt","cmd_post":"rm -f input.txt","idx":10,"norm_rules":[]}
{"name":"squeeze_blank_flag","description":"Squeeze multiple blank lines with -s","cmd_prep":"echo -e 'Line 1\\n\\n\\n\\nLine 2' > input.txt","cmd_target":"BINARY -s input.txt","cmd_post":"rm -f input.txt","idx":11,"norm_rules":[]}
{"name":"show_nonprinting_flag","description":"Show non-printing characters with -v","cmd_prep":"printf 'Hello\\x01\\x02World' > input.txt","cmd_target":"BINARY -v input.txt","cmd_post":"rm -f input.txt","idx":12,"norm_rules":[]}
{"name":"unbuffered_flag","description":"Unbuffered output with -u","cmd_prep":"echo 'Test unbuffered' > input.txt","cmd_target":"BINARY -u input.txt","cmd_post":"rm -f input.txt","idx":13,"norm_rules":[]}
{"name":"combined_flags","description":"Multiple flags combined","cmd_prep":"echo -e 'Line 1\\n\\nLine 3\\tTab' > input.txt","cmd_target":"BINARY -net input.txt","cmd_post":"rm -f input.txt","idx":14,"norm_rules":[]}
{"name":"large_file","description":"Cat large file","cmd_prep":"seq 1 1000 > large.txt","cmd_target":"BINARY large.txt","cmd_post":"rm -f large.txt","idx":15,"norm_rules":[]}

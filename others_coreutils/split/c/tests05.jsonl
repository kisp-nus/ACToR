{"name": "split_numeric_start_with_chunks", "description": "Test numeric suffix start with chunk mode", "cmd_prep": "echo -e 'line1\\nline2\\nline3\\nline4\\nline5\\nline6' > input.txt", "cmd_target": "BINARY -n 3 --numeric-suffixes=10 input.txt out_", "cmd_post": "rm -f input.txt out_*", "idx": 1, "norm_rules": []}
{"name": "split_version_output", "description": "Test --version flag", "cmd_prep": "", "cmd_target": "BINARY --version", "cmd_post": "", "idx": 2, "norm_rules": [{"pattern": "split \\(GNU coreutils\\) [0-9.]+", "replacement": "split (GNU coreutils) VERSION"}, {"pattern": "Copyright \\(C\\) [0-9]+", "replacement": "Copyright (C) YEAR"}]}
{"name": "split_bytes_chunk_extract", "description": "Test extracting specific byte chunk K/N", "cmd_prep": "echo -e 'AAAA\\nBBBB\\nCCCC\\nDDDD\\nEEEE\\nFFFF' > input.txt", "cmd_target": "BINARY -n 2/5 input.txt", "cmd_post": "rm -f input.txt", "idx": 3, "norm_rules": []}
{"name": "split_pipe_chunk_mode", "description": "Test chunk mode with pipe input", "cmd_prep": "", "cmd_target": "echo -e 'line1\\nline2\\nline3\\nline4' | BINARY -n l/2 - outpipe_", "cmd_post": "rm -f outpipe_*", "idx": 4, "norm_rules": []}
{"name": "split_elide_with_lines", "description": "Test elide empty files with line mode", "cmd_prep": "echo -e 'data' > input.txt", "cmd_target": "BINARY -e -n 10 input.txt outelide_", "cmd_post": "rm -f input.txt outelide_*", "idx": 5, "norm_rules": []}
{"name": "split_io_blksize_custom", "description": "Test custom IO block size", "cmd_prep": "dd if=/dev/zero bs=1024 count=10 2>/dev/null > input.dat", "cmd_target": "BINARY --io-blksize=512 -b 2K input.dat outio_", "cmd_post": "rm -f input.dat outio_*", "idx": 6, "norm_rules": []}
{"name": "split_suffix_auto_increment", "description": "Test suffix auto increment with many files", "cmd_prep": "seq 1 100 > input.txt", "cmd_target": "BINARY -l 2 -a 1 input.txt outauto_", "cmd_post": "rm -f input.txt outauto_*", "idx": 7, "norm_rules": []}
{"name": "split_numeric_hex_combo", "description": "Test hex suffixes with start value", "cmd_prep": "echo -e 'test1\\ntest2\\ntest3\\ntest4' > input.txt", "cmd_target": "BINARY -l 2 --hex-suffixes=a input.txt outhex_", "cmd_post": "rm -f input.txt outhex_*", "idx": 8, "norm_rules": []}
{"name": "split_separator_with_chunks", "description": "Test custom separator with chunk mode", "cmd_prep": "echo -e 'a:b:c:d:e:f' > input.txt", "cmd_target": "BINARY -t : -n l/3 input.txt outsep_", "cmd_post": "rm -f input.txt outsep_*", "idx": 9, "norm_rules": []}
{"name": "split_unbuffered_lines", "description": "Test unbuffered mode with line splitting", "cmd_prep": "echo -e 'line1\\nline2\\nline3\\nline4' > input.txt", "cmd_target": "BINARY -u -n r/2 input.txt outunbuf_", "cmd_post": "rm -f input.txt outunbuf_*", "idx": 10, "norm_rules": []}
{"name": "split_additional_suffix_chunks", "description": "Test additional suffix with chunk mode", "cmd_prep": "echo -e 'data1\\ndata2\\ndata3' > input.txt", "cmd_target": "BINARY -n 2 --additional-suffix=.txt input.txt outadd_", "cmd_post": "rm -f input.txt outadd_*", "idx": 11, "norm_rules": []}
{"name": "split_verbose_chunks", "description": "Test verbose mode with chunks", "cmd_prep": "echo -e 'A\\nB\\nC' > input.txt", "cmd_target": "BINARY --verbose -n 2 input.txt outverb_", "cmd_post": "rm -f input.txt outverb_*", "idx": 12, "norm_rules": [{"pattern": "creating file ['`]outverb_[^']+['\u2019]", "replacement": "creating file 'outverb_XX'"}]}
{"name": "split_line_bytes_unbuffered", "description": "Test line-bytes mode with specific size", "cmd_prep": "printf 'aaaa\\nbbbb\\ncccc\\ndddd\\neeee\\n' > input.txt", "cmd_target": "BINARY -C 10 input.txt outlb_", "cmd_post": "rm -f input.txt outlb_*", "idx": 13, "norm_rules": []}
{"name": "split_rr_extract_middle", "description": "Test round-robin extract middle chunk", "cmd_prep": "seq 1 20 > input.txt", "cmd_target": "BINARY -n r/2/4 input.txt", "cmd_post": "rm -f input.txt", "idx": 14, "norm_rules": []}
{"name": "split_chunk_lines_pipe", "description": "Test line chunk mode from pipe", "cmd_prep": "", "cmd_target": "seq 1 12 | BINARY -n l/3 - outpipel_", "cmd_post": "rm -f outpipel_*", "idx": 15, "norm_rules": []}

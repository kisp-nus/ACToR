{"name":"split_additional_suffix_basic","description":"split --lines=2 --additional-suffix=.txt produces correctly named/segmented files","cmd_prep":"rm -f in xa*.txt && printf '1\\n2\\n3\\n4\\n5\\n' > in","cmd_target":"BINARY --lines=2 --additional-suffix=.txt in && cat xaa.txt && echo --- && cat xab.txt && echo --- && cat xac.txt","cmd_post":"rm -f in xa*.txt","idx":1,"norm_rules":[]}
{"name":"split_additional_suffix_slash_fail_a","description":"--additional-suffix=a/b (with slash) must be rejected","cmd_prep":"rm -f in && printf '1\\n2\\n3\\n4\\n5\\n' > in","cmd_target":"BINARY --lines=2 --additional-suffix=a/b in 2>&1; echo exit=$?","cmd_post":"rm -f in xa*","idx":2,"norm_rules":[{"pattern":"\\./{progname}:","replacement":"split:"},{"pattern":"^{progname}:","replacement":"split:"}]}
{"name":"split_additional_suffix_slash_fail_b","description":"--additional-suffix=a/ (trailing slash) must be rejected","cmd_prep":"rm -f in && printf '1\\n2\\n3\\n4\\n5\\n' > in","cmd_target":"BINARY --lines=2 --additional-suffix=a/ in 2>&1; echo exit=$?","cmd_post":"rm -f in xa*","idx":3,"norm_rules":[{"pattern":"\\./{progname}:","replacement":"split:"},{"pattern":"^{progname}:","replacement":"split:"}]}
{"name":"split_lines_basic","description":"split --lines=2 splits a 5-line input into 3 files (xaa,xab,xac); xad must not exist","cmd_prep":"rm -f in xa* && printf '1\\n2\\n3\\n4\\n5\\n' > in","cmd_target":"BINARY --lines=2 in && cat xaa && echo --- && cat xab && echo --- && cat xac && test ! -f xad && echo NOXAD","cmd_post":"rm -f in xa*","idx":4,"norm_rules":[]}
{"name":"split_n_more_than_size","description":"split -n 10 of /dev/null produces 10 zero-sized files","cmd_prep":"rm -f x??","cmd_target":"BINARY -n 10 /dev/null && stat -c %s x* | uniq -c | sed 's/^ *//; s/ /x/'","cmd_post":"rm -f x??","idx":5,"norm_rules":[]}
